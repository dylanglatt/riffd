# Rename this file to .env and fill in your Spotify credentials.
# Get these for free at: https://developer.spotify.com/dashboard
# (Search works without these — you'll just get a message to set them up)

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ─── Optional ───────────────────────────────────────────────────────────────

# Crash reporting. No hardcoded fallback — leave unset and Sentry is a no-op.
SENTRY_DSN=

# Admin endpoints (/api/admin/refresh-cookies, /cookie-status, /diag-audio)
# fail CLOSED (403) when this is unset. Set it to enable them.
ADMIN_SECRET=

# Reject new jobs when parent RSS exceeds this. MUST stay below the instance
# ceiling (2048MB on Render Standard) or the OOM killer fires first.
MEMORY_GUARD_MB=1400
